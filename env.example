# Postgres connection string (e.g. Neon, Supabase, or local Postgres)
DATABASE_URL=

# Better Auth
# Generate a secret with: npx @better-auth/cli secret
BETTER_AUTH_SECRET=
# Base URL of this app. Must match the domain you're running on
# (http://localhost:3000 for dev, your real domain in production) or
# OAuth sign-in will fail with a redirect_uri mismatch.
BETTER_AUTH_URL=http://localhost:3000

# GitHub OAuth App (github.com/settings/developers)
# Authorization callback URL: {BETTER_AUTH_URL}/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Google OAuth Client (console.cloud.google.com)
# Authorized redirect URI: {BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Public app URL, used by the client. Keep in sync with BETTER_AUTH_URL.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Stream (getstream.io) - Video and Chat
NEXT_PUBLIC_STREAM_VIDEO_API_KEY=
STREAM_VIDEO_SECRET_KEY=
NEXT_PUBLIC_STREAM_CHAT_API_KEY=
STREAM_CHAT_SECRET_KEY=

# OpenAI - meeting summaries and in-call agents
OPENAI_API_KEY=

# Polar (polar.sh) - billing / subscriptions
POLAR_ACCESS_TOKEN=

# Inngest - set to 1 to run against the local Inngest dev server
INNGEST_DEV=1
